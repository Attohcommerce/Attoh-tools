{% comment %}
  SIZE GUIDE — Attoh Tools v2.3-LGB (12-10-2026) — Lady Glam Boutique
  Strakke versie: dunne letters, LGB-kleuren (pruim #5B3947, mauve #8E6C7A,
  lijn #E7DCD4, frost #F6F1EE), header + kruisje blijven altijd in beeld,
  alleen de tabel scrolt (kolomkoppen blijven staan), ligt boven de sticky
  header, sluiten via kruisje / klik naast venster / Esc. Mobiel = sheet van onderen.

  Data: product-metafield custom.size_guide (json, Size Guide-module).
  Geen metafield → er wordt niets gerenderd. Velden: columns, rows, unit_default,
  fit ("small" | "true" | "large"), alert, note, how_to_measure.

  Plaatsen: Edit code → Snippets → size-guide.liquid → alles vervangen door dit
  bestand. In de productpagina een Custom Liquid-blok onder de maatkiezer met:
    {% render 'size-guide', product: product %}
{% endcomment %}
{%- assign sg = product.metafields.custom.size_guide.value -%}
{%- if sg and sg.rows.size > 0 -%}
{%- assign sg_id = 'sg-' | append: product.id -%}
{%- assign sg_unit = sg.unit_default | default: 'cm' -%}
<style>
  .sg-wrap,.sg-modal{--sg-ink:#2B2427;--sg-plum:#5B3947;--sg-muted:#8E6C7A;--sg-line:#E7DCD4;--sg-soft:#F0E8E2;--sg-frost:#F6F1EE;--sg-zebra:#FCFAF9;--sg-bg:#fff;--sg-alert:#C20000;--sg-alert-bg:#FDF1F1}
  .sg-wrap{font-family:inherit;text-align:left!important;margin:.6rem 0 1rem;display:flex;justify-content:flex-start!important}
  .sg-open{display:inline-flex;align-items:center;gap:.45rem;background:none;border:0;padding:0;font:inherit;font-size:.7rem;font-weight:400;letter-spacing:.16em;text-transform:uppercase;color:var(--sg-plum);cursor:pointer;line-height:1.2}
  .sg-open svg{width:17px;height:17px;flex:none;color:var(--sg-muted)}
  .sg-open span{border-bottom:1px solid var(--sg-line);padding-bottom:.15rem;transition:border-color .15s}
  .sg-open:hover span{border-bottom-color:var(--sg-plum)}

  .sg-modal[hidden]{display:none!important}
  .sg-modal{position:fixed;inset:0;z-index:2147483000;display:flex;align-items:center;justify-content:center;padding:1.25rem;font-family:inherit}
  .sg-overlay{position:absolute;inset:0;background:rgba(43,36,39,.42);cursor:pointer}
  .sg-panel{position:relative;background:var(--sg-bg);color:var(--sg-ink);width:100%;max-width:540px;max-height:84vh;display:flex;flex-direction:column;overflow:hidden;border-radius:6px;box-shadow:0 18px 50px rgba(43,36,39,.2);text-align:left!important;animation:sgIn .18s ease-out}

  .sg-head{flex:none;display:flex;align-items:center;gap:.9rem;padding:.95rem 1.1rem .95rem 1.4rem;border-bottom:1px solid var(--sg-line);background:var(--sg-bg)}
  .sg-title{flex:1;margin:0;font-family:inherit;font-size:.74rem;font-weight:400;letter-spacing:.2em;text-transform:uppercase;color:var(--sg-plum)}
  .sg-units{display:inline-flex;border:1px solid var(--sg-line);border-radius:999px;overflow:hidden}
  .sg-units button{background:none;border:0;font:inherit;font-size:.66rem;font-weight:400;letter-spacing:.12em;text-transform:uppercase;padding:.32rem .8rem;cursor:pointer;color:var(--sg-muted);transition:background .15s,color .15s}
  .sg-units button.on{background:var(--sg-plum);color:#fff}
  .sg-close{flex:none;width:34px;height:34px;border:0;border-radius:50%;background:var(--sg-frost);color:var(--sg-plum);font:inherit;font-size:1.35rem;font-weight:300;line-height:1;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:background .15s}
  .sg-close:hover{background:var(--sg-line)}

  .sg-body{flex:1 1 auto;min-height:0;overflow:auto;-webkit-overflow-scrolling:touch;padding:1rem 1.4rem 1.3rem}
  .sg-alert{margin:0 0 .9rem;padding:.6rem .8rem;background:var(--sg-alert-bg);border-left:2px solid var(--sg-alert);border-radius:3px;color:var(--sg-alert);font-size:.8rem;font-weight:400;line-height:1.45}

  .sg-fit{margin:.1rem 0 1.1rem;padding:0 .2rem}
  .sg-fit-track{position:relative;height:1px;background:var(--sg-line);margin:0 .35rem}
  .sg-fit-track::before,.sg-fit-track::after{content:"";position:absolute;top:50%;width:1px;height:7px;background:var(--sg-line);transform:translateY(-50%)}
  .sg-fit-track::before{left:0}.sg-fit-track::after{right:0}
  .sg-fit-dot{position:absolute;top:50%;left:50%;width:11px;height:11px;border-radius:50%;background:var(--sg-plum);border:2px solid var(--sg-bg);box-shadow:0 0 0 1px var(--sg-plum);transform:translate(-50%,-50%)}
  .sg-fit[data-fit="small"] .sg-fit-dot{left:8%}
  .sg-fit[data-fit="large"] .sg-fit-dot{left:92%}
  .sg-fit-labels{display:flex;justify-content:space-between;margin-top:.55rem;font-size:.6rem;font-weight:400;letter-spacing:.14em;text-transform:uppercase;color:var(--sg-muted)}
  .sg-fit-labels span{flex:1}
  .sg-fit-labels span:nth-child(2){text-align:center}
  .sg-fit-labels span:nth-child(3){text-align:right}
  .sg-fit[data-fit="true"] .sg-fit-labels span:nth-child(2),.sg-fit[data-fit="small"] .sg-fit-labels span:nth-child(1),.sg-fit[data-fit="large"] .sg-fit-labels span:nth-child(3){color:var(--sg-plum)}

  .sg-scroll{overflow-x:auto;-webkit-overflow-scrolling:touch;border:1px solid var(--sg-soft);border-radius:4px}
  .sg-table{width:100%;border-collapse:collapse;font-size:.84rem;min-width:300px}
  .sg-table th,.sg-table td{text-align:left!important;padding:.5rem .75rem;white-space:nowrap;line-height:1.3;font-weight:400}
  .sg-table thead th{position:sticky;top:0;z-index:1;background:var(--sg-frost);font-size:.6rem;letter-spacing:.16em;text-transform:uppercase;color:var(--sg-plum)}
  .sg-table tbody td{color:var(--sg-ink);border-top:1px solid var(--sg-soft)}
  .sg-table tbody tr:nth-child(even) td{background:var(--sg-zebra)}
  .sg-table tbody tr:hover td{background:var(--sg-frost)}
  .sg-table tbody td:first-child{color:var(--sg-plum);font-weight:500}
  .sg-table .sg-u{font-size:.85em;color:var(--sg-muted);margin-left:.25em;letter-spacing:.06em;text-transform:none}
  .sg-wrap[data-unit="in"] .sg-cm,.sg-wrap[data-unit="cm"] .sg-in,.sg-modal[data-unit="in"] .sg-cm,.sg-modal[data-unit="cm"] .sg-in{display:none}

  .sg-note{margin:.9rem 0 0;font-size:.78rem;font-weight:400;color:var(--sg-muted);line-height:1.55;letter-spacing:.01em;text-transform:none}
  .sg-how{margin:.9rem 0 0;border-top:1px solid var(--sg-line)}
  .sg-how summary{list-style:none;cursor:pointer;padding:.8rem 0 .2rem;font-size:.66rem;font-weight:400;letter-spacing:.16em;text-transform:uppercase;color:var(--sg-plum);display:flex;align-items:center;gap:.5rem}
  .sg-how summary::-webkit-details-marker{display:none}
  .sg-how summary::after{content:"+";margin-left:auto;font-size:1rem;font-weight:300;color:var(--sg-muted)}
  .sg-how[open] summary::after{content:"–"}
  .sg-how ul{margin:.3rem 0 0;padding:0;list-style:none;font-size:.8rem;font-weight:400;line-height:1.55;color:#5E5458}
  .sg-how li{padding:.5rem 0;border-top:1px solid var(--sg-soft)}
  .sg-how li:first-child{border-top:0}
  .sg-how strong{font-weight:400;color:var(--sg-plum);font-size:.62rem;letter-spacing:.14em;text-transform:uppercase;display:block;margin-bottom:.15rem}

  @media (max-width:749px){
    .sg-modal{align-items:flex-end;padding:0}
    .sg-panel{max-width:none;max-height:88vh;border-radius:14px 14px 0 0;box-shadow:0 -10px 40px rgba(43,36,39,.2);animation:sgUp .22s ease-out}
    .sg-head{padding:.85rem .9rem .85rem 1.1rem}
    .sg-body{padding:.9rem 1rem 1.4rem}
    .sg-table{font-size:.8rem}
    .sg-table th,.sg-table td{padding:.48rem .55rem}
  }
  @keyframes sgIn{from{transform:translateY(8px);opacity:0}to{transform:none;opacity:1}}
  @keyframes sgUp{from{transform:translateY(24px);opacity:.6}to{transform:none;opacity:1}}
</style>
<div class="sg-wrap" id="{{ sg_id }}" data-unit="{{ sg_unit }}">
  <button type="button" class="sg-open" aria-haspopup="dialog" aria-controls="{{ sg_id }}-modal">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true"><rect x="2.5" y="8" width="19" height="8" rx="1.5"/><path d="M6.5 8v3M10 8v4.5M13.5 8v3M17 8v4.5"/></svg>
    <span>Size guide</span>
  </button>
  <div class="sg-modal" id="{{ sg_id }}-modal" role="dialog" aria-modal="true" aria-label="Size guide" hidden>
    <div class="sg-overlay" data-sg-close></div>
    <div class="sg-panel">
      <div class="sg-head">
        <h2 class="sg-title">Size guide</h2>
        <div class="sg-units" role="group" aria-label="Units">
          <button type="button" data-sg-unit="cm"{% if sg_unit == 'cm' %} class="on"{% endif %}>cm</button>
          <button type="button" data-sg-unit="in"{% if sg_unit == 'in' %} class="on"{% endif %}>in</button>
        </div>
        <button type="button" class="sg-close" aria-label="Close size guide" data-sg-close>&times;</button>
      </div>
      <div class="sg-body">
        {%- if sg.alert != blank -%}<p class="sg-alert" role="note">{{ sg.alert | escape }}</p>{%- endif -%}
        {%- assign sg_fit = sg.fit | default: 'true' -%}
        <div class="sg-fit" data-fit="{{ sg_fit }}" aria-label="Fit: {% if sg_fit == 'small' %}runs small{% elsif sg_fit == 'large' %}runs large{% else %}true to size{% endif %}">
          <div class="sg-fit-track"><span class="sg-fit-dot"></span></div>
          <div class="sg-fit-labels"><span>Runs small</span><span>True to size</span><span>Runs large</span></div>
        </div>
        <div class="sg-scroll">
          <table class="sg-table">
            <thead>
              <tr>
                {%- for c in sg.columns -%}
                  <th scope="col">{{ c.label | escape }}{% if c.kind == 'length' %}<span class="sg-u sg-in">in</span><span class="sg-u sg-cm">cm</span>{% elsif c.kind == 'mass' %}<span class="sg-u sg-in">lb</span><span class="sg-u sg-cm">kg</span>{% endif %}</th>
                {%- endfor -%}
              </tr>
            </thead>
            <tbody>
              {%- for row in sg.rows -%}
                <tr>
                  {%- for c in sg.columns -%}
                    {%- assign v = row[c.key] -%}
                    <td>
                      {%- if v == blank -%}
                        &ndash;
                      {%- elsif c.kind == 'length' or c.kind == 'mass' -%}
                        {%- if c.kind == 'length' -%}{%- assign f = 0.3937 -%}{%- else -%}{%- assign f = 2.2046 -%}{%- endif -%}
                        {%- comment -%} Bereik [86,89] = JSON-array; join + split werkt voor array, getal én "86-89". {%- endcomment -%}
                        {%- assign parts = v | join: '-' | split: '-' -%}
                        {%- if parts.size > 1 -%}
                          {%- assign a = parts[0] | times: 1.0 -%}{%- assign b = parts[1] | times: 1.0 -%}
                          <span class="sg-in">{{ a | times: f | round: 1 | append: '' | replace: '.0', '' }}&ndash;{{ b | times: f | round: 1 | append: '' | replace: '.0', '' }}</span><span class="sg-cm">{{ a | round: 1 | append: '' | replace: '.0', '' }}&ndash;{{ b | round: 1 | append: '' | replace: '.0', '' }}</span>
                        {%- else -%}
                          {%- assign a = parts[0] | times: 1.0 -%}
                          <span class="sg-in">{{ a | times: f | round: 1 | append: '' | replace: '.0', '' }}</span><span class="sg-cm">{{ a | round: 1 | append: '' | replace: '.0', '' }}</span>
                        {%- endif -%}
                      {%- else -%}
                        {{ v | escape }}
                      {%- endif -%}
                    </td>
                  {%- endfor -%}
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        </div>
        {%- if sg.note != blank -%}<p class="sg-note">{{ sg.note | escape }}</p>{%- endif -%}
        {%- if sg.how_to_measure.size > 0 -%}
          <details class="sg-how">
            <summary>How to measure</summary>
            <ul>
              {%- for h in sg.how_to_measure -%}
                {%- assign lbl = h.key -%}
                {%- for c in sg.columns -%}{%- if c.key == h.key -%}{%- assign lbl = c.label -%}{%- endif -%}{%- endfor -%}
                <li><strong>{{ lbl | escape }}</strong>{{ h.text | escape }}</li>
              {%- endfor -%}
            </ul>
          </details>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>
<script>
  (function () {
    var wrap = document.getElementById('{{ sg_id }}');
    if (!wrap || wrap.dataset.sgReady) return;
    wrap.dataset.sgReady = '1';
    var modal = wrap.querySelector('.sg-modal');
    var openBtn = wrap.querySelector('.sg-open');
    var KEY = 'sg_unit';
    /* modal naar <body>: dan valt hij nooit onder de sticky header of in een overflow-container */
    var home = modal.parentNode;
    function setUnit(u, save) {
      wrap.setAttribute('data-unit', u);
      modal.setAttribute('data-unit', u);
      modal.querySelectorAll('[data-sg-unit]').forEach(function (b) { b.classList.toggle('on', b.getAttribute('data-sg-unit') === u); });
      if (save) { try { localStorage.setItem(KEY, u); } catch (e) {} }
    }
    setUnit(wrap.getAttribute('data-unit'), false);
    try { var saved = localStorage.getItem(KEY); if (saved === 'in' || saved === 'cm') setUnit(saved, false); } catch (e) {}
    function open() {
      document.body.appendChild(modal);
      modal.hidden = false;
      document.documentElement.style.overflow = 'hidden';
      var c = modal.querySelector('.sg-close'); if (c) c.focus();
    }
    function close() {
      modal.hidden = true;
      document.documentElement.style.overflow = '';
      home.appendChild(modal);
      openBtn.focus();
    }
    openBtn.addEventListener('click', open);
    modal.querySelectorAll('[data-sg-close]').forEach(function (el) { el.addEventListener('click', close); });
    modal.querySelectorAll('[data-sg-unit]').forEach(function (b) { b.addEventListener('click', function () { setUnit(b.getAttribute('data-sg-unit'), true); }); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !modal.hidden) close(); });
  })();
</script>
{%- endif -%}
