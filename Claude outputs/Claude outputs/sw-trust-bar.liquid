{%- comment -%} SW — Trust bar (glass) · sections/sw-trust-bar.liquid {%- endcomment -%}
{%- assign s = section.settings -%}
<div class="sw-trust sw-trust--{{ s.align }}{% if s.band %} sw-trust--band{% endif %}" style="--tb-pt:{{ s.padding_top }}px;--tb-pb:{{ s.padding_bottom }}px;--tb-max:{{ s.max_width }}px;--tb-cols:{{ section.blocks.size | at_most: 4 | at_least: 1 }}">
  <div class="sw-trust__inner">
    {%- if s.eyebrow != blank or s.heading != blank -%}
      <div class="sw-trust__head">
        {%- if s.eyebrow != blank -%}<p class="sw-trust__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="sw-trust__heading">{{ s.heading }}</h2>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="sw-trust__grid" role="list">
      {%- for block in section.blocks -%}
        <div class="sw-trust__item" role="listitem" {{ block.shopify_attributes }}>
          <span class="sw-trust__icon" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'truck' -%}<svg viewBox="0 0 24 24"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="17.5" r="1.6"/><circle cx="17.5" cy="17.5" r="1.6"/></svg>
              {%- when 'chat' -%}<svg viewBox="0 0 24 24"><path d="M4 5.5A1.5 1.5 0 0 1 5.5 4h13A1.5 1.5 0 0 1 20 5.5v9a1.5 1.5 0 0 1-1.5 1.5H9l-4.5 4v-4A1.5 1.5 0 0 1 4 14.5z"/></svg>
              {%- when 'return' -%}<svg viewBox="0 0 24 24"><path d="M4 12a8 8 0 1 0 2.4-5.7"/><path d="M4 4v4.5h4.5"/></svg>
              {%- when 'shield' -%}<svg viewBox="0 0 24 24"><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/><path d="M9 12l2 2 4-4"/></svg>
              {%- when 'lock' -%}<svg viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7.5a4 4 0 0 1 8 0V11"/></svg>
              {%- when 'star' -%}<svg viewBox="0 0 24 24"><path d="M12 3.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.8L12 16.8l-5.3 2.8 1.1-5.8-4.3-4.1 5.9-.8z"/></svg>
              {%- when 'leaf' -%}<svg viewBox="0 0 24 24"><path d="M5 19c0-8 5-13 14-14-1 9-6 14-14 14z"/><path d="M5 19l8-8"/></svg>
              {%- when 'box' -%}<svg viewBox="0 0 24 24"><path d="M3 8l9-4 9 4v8l-9 4-9-4z"/><path d="M3 8l9 4 9-4M12 12v8"/></svg>
              {%- when 'tag' -%}<svg viewBox="0 0 24 24"><path d="M3 12V4h8l10 10-8 8z"/><circle cx="7.5" cy="8.5" r="1.4"/></svg>
              {%- else -%}<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/><path d="M9 12l2 2 4-4"/></svg>
            {%- endcase -%}
          </span>
          {%- if block.settings.heading != blank -%}<h3 class="sw-trust__title">{{ block.settings.heading }}</h3>{%- endif -%}
          {%- if block.settings.text != blank -%}<div class="sw-trust__text">{{ block.settings.text }}</div>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  #shopify-section-{{ section.id }} .sw-trust{--ink:#1C1D1D;--sage:#4F5D45;--mute:#7C8277;--hair:rgba(28,29,29,.08);
    padding:var(--tb-pt) 20px var(--tb-pb);font-family:inherit;background:transparent}
  #shopify-section-{{ section.id }} .sw-trust--band{background:#F7F7F4}
  #shopify-section-{{ section.id }} .sw-trust__inner{max-width:var(--tb-max);margin:0 auto}
  #shopify-section-{{ section.id }} .sw-trust__head{margin:0 0 18px}
  #shopify-section-{{ section.id }} .sw-trust--center .sw-trust__head{text-align:center}
  #shopify-section-{{ section.id }} .sw-trust__eyebrow{margin:0 0 6px;font-size:11px;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:var(--sage)}
  #shopify-section-{{ section.id }} .sw-trust__heading{margin:0;font-size:22px;font-weight:400;letter-spacing:.01em;color:var(--ink)}
  #shopify-section-{{ section.id }} .sw-trust__grid{display:grid;grid-template-columns:repeat(var(--tb-cols),1fr);
    border:1px solid var(--hair);border-radius:22px;overflow:hidden;
    background:linear-gradient(180deg,rgba(255,255,255,.94),rgba(255,255,255,.78));
    -webkit-backdrop-filter:blur(18px) saturate(1.15);backdrop-filter:blur(18px) saturate(1.15);
    box-shadow:inset 0 1px 0 rgba(255,255,255,.9),0 18px 44px -34px rgba(28,29,29,.45)}
  #shopify-section-{{ section.id }} .sw-trust__item{position:relative;display:flex;flex-direction:column;gap:10px;padding:26px 24px 24px;min-width:0;transition:background .25s ease}
  #shopify-section-{{ section.id }} .sw-trust__item+.sw-trust__item{border-left:1px solid var(--hair)}
  #shopify-section-{{ section.id }} .sw-trust__item:hover{background:rgba(79,93,69,.035)}
  #shopify-section-{{ section.id }} .sw-trust--center .sw-trust__item{align-items:center;text-align:center}
  #shopify-section-{{ section.id }} .sw-trust__icon{display:inline-flex;align-items:center;justify-content:center;width:38px;height:38px;border-radius:12px;
    background:linear-gradient(135deg,rgba(79,93,69,.14),rgba(79,93,69,.06));border:1px solid rgba(79,93,69,.16);color:var(--sage);margin-bottom:2px;transition:transform .3s ease}
  #shopify-section-{{ section.id }} .sw-trust__item:hover .sw-trust__icon{transform:translateY(-2px)}
  #shopify-section-{{ section.id }} .sw-trust__icon svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
  #shopify-section-{{ section.id }} .sw-trust__title{margin:0;font-size:11px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:var(--ink);line-height:1.3}
  #shopify-section-{{ section.id }} .sw-trust__text{font-size:13px;line-height:1.55;color:var(--mute);letter-spacing:-.002em}
  #shopify-section-{{ section.id }} .sw-trust__text p{margin:0}
  #shopify-section-{{ section.id }} .sw-trust__text strong{font-weight:500;color:var(--ink)}
  @media(max-width:989px){
    #shopify-section-{{ section.id }} .sw-trust__grid{grid-template-columns:1fr 1fr}
    #shopify-section-{{ section.id }} .sw-trust__item{padding:22px 20px 20px}
    #shopify-section-{{ section.id }} .sw-trust__item:nth-child(odd){border-left:0}
    #shopify-section-{{ section.id }} .sw-trust__item:nth-child(n+3){border-top:1px solid var(--hair)}
  }
  @media(max-width:600px){
    /* phone: no card, no sticker — a flat list with hairlines */
    #shopify-section-{{ section.id }} .sw-trust{padding-left:20px;padding-right:20px}
    #shopify-section-{{ section.id }} .sw-trust__grid{grid-template-columns:1fr;border:0;border-radius:0;background:transparent;box-shadow:none;-webkit-backdrop-filter:none;backdrop-filter:none;border-top:1px solid var(--hair);border-bottom:1px solid var(--hair)}
    #shopify-section-{{ section.id }} .sw-trust__item{display:grid;grid-template-columns:34px 1fr;grid-template-rows:auto auto;column-gap:14px;row-gap:3px;padding:18px 0;text-align:left;background:transparent}
    #shopify-section-{{ section.id }} .sw-trust__item:hover{background:transparent}
    #shopify-section-{{ section.id }} .sw-trust--center .sw-trust__item{text-align:left;justify-items:start}
    #shopify-section-{{ section.id }} .sw-trust__item+.sw-trust__item{border-left:0;border-top:1px solid var(--hair)}
    #shopify-section-{{ section.id }} .sw-trust__item:nth-child(n+3){border-top:1px solid var(--hair)}
    #shopify-section-{{ section.id }} .sw-trust__icon{grid-row:1/3;width:34px;height:34px;margin:0;align-self:start}
    #shopify-section-{{ section.id }} .sw-trust__title{margin-top:8px}
    #shopify-section-{{ section.id }} .sw-trust__text{font-size:13px}
  }
</style>

{% schema %}
{
  "name": "Trust bar (SW)",
  "tag": "section",
  "class": "sw-trust-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (optional)" },
    { "type": "text", "id": "heading", "label": "Heading (optional)" },
    { "type": "select", "id": "align", "label": "Alignment", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ], "default": "left" },
    { "type": "checkbox", "id": "band", "label": "Soft background band", "default": false },
    { "type": "range", "id": "max_width", "label": "Max width", "min": 900, "max": 1600, "step": 20, "unit": "px", "default": 1280 },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "limit": 4,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "truck", "label": "Truck" }, { "value": "chat", "label": "Chat" }, { "value": "return", "label": "Return" },
          { "value": "shield", "label": "Shield" }, { "value": "lock", "label": "Lock" }, { "value": "star", "label": "Star" },
          { "value": "leaf", "label": "Leaf" }, { "value": "box", "label": "Box" }, { "value": "tag", "label": "Tag" }, { "value": "check", "label": "Check" }
        ], "default": "truck" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Free fast shipping" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Every order ships free with Australia Post or NZ Post, tracked from checkout to your door.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust bar (SW)",
      "blocks": [
        { "type": "item", "settings": { "icon": "truck", "heading": "Free fast shipping", "text": "<p>Every order ships free with <strong>Australia Post</strong> or <strong>NZ Post</strong>, tracked from checkout to your door.</p>" } },
        { "type": "item", "settings": { "icon": "chat", "heading": "Customer service", "text": "<p>A question about your order or your size? A real person replies within 24 hours, Monday to Friday.</p>" } },
        { "type": "item", "settings": { "icon": "return", "heading": "30-day returns", "text": "<p>Not quite right? Send it back within 30 days of delivery — unworn, tags attached.</p>" } },
        { "type": "item", "settings": { "icon": "shield", "heading": "Secure payment", "text": "<p>Encrypted checkout with Visa, Mastercard, American Express, Apple Pay, Google Pay and Shop Pay.</p>" } }
      ]
    }
  ]
}
{% endschema %}
