{% comment %}
  SIZE GUIDE — Attoh Tools (v2, 03-09-2026, gestyled op Soul Society Boutique / Impulse)
  Toont de maattabel uit product-metafield custom.size_guide (json, geschreven
  door de Size Guide-module). Geen metafield → er wordt niets gerenderd.

  Plaatsen: Customize → productpagina → sectie Product → blok "Custom Liquid"
  met   {% render 'size-guide', product: product %}   direct onder/boven de
  maten-kiezer. (Dawn: zelfde blok; of in sections/main-product.liquid.)

  Per store alleen de CSS-variabelen bovenaan aanpassen (inkt, lijn, accent);
  font is altijd het thema-font (font-family: inherit). Bewust weinig tekst:
  tabel + één regel uitleg; meetinstructies ingeklapt (CVR).
{% endcomment %}
{%- assign sg = product.metafields.custom.size_guide.value -%}
{%- if sg and sg.rows.size > 0 -%}
{%- assign sg_id = 'sg-' | append: product.id -%}
{%- assign sg_unit = sg.unit_default | default: 'in' -%}
<style>
  .sg-wrap{--sg-ink:#2a3743;--sg-muted:#6f7a86;--sg-line:#e8e4de;--sg-head:#f7f5f2;--sg-accent:#2a3743;--sg-bg:#fff;font-family:inherit;text-align:left!important;margin:.75rem 0 1.1rem;display:flex;justify-content:flex-start!important}
  .sg-open{display:inline-flex;align-items:center;gap:.45rem;background:none;border:0;padding:0;font:inherit;font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;color:var(--sg-ink);cursor:pointer;line-height:1.2}
  .sg-open svg{width:17px;height:17px;flex:none;color:var(--sg-accent)}
  .sg-open span{border-bottom:1px solid var(--sg-line);padding-bottom:.15rem;transition:border-color .15s}
  .sg-open:hover span{border-bottom-color:var(--sg-accent)}
  .sg-modal[hidden]{display:none}
  .sg-modal{position:fixed;inset:0;z-index:2000;display:flex;align-items:center;justify-content:center;padding:1.25rem}
  .sg-overlay{position:absolute;inset:0;background:rgba(42,55,67,.38)}
  .sg-panel{position:relative;background:var(--sg-bg);color:var(--sg-ink);max-width:640px;width:100%;max-height:88vh;overflow:auto;padding:1.6rem 1.9rem 1.8rem;border-radius:4px;box-shadow:0 18px 50px rgba(20,28,36,.18);text-align:left!important;font-family:inherit}
  .sg-head{display:flex;align-items:center;justify-content:flex-start!important;gap:1rem;padding-bottom:.9rem;margin-bottom:.9rem;border-bottom:1px solid var(--sg-line)}
  .sg-title{margin:0;font-size:.78rem;letter-spacing:.18em;text-transform:uppercase;font-weight:600;color:var(--sg-ink)}
  .sg-units{margin-left:auto;display:inline-flex;gap:.2rem}
  .sg-units button{background:none;border:0;font:inherit;font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;padding:.3rem .5rem;cursor:pointer;color:var(--sg-muted);border-bottom:2px solid transparent}
  .sg-units button.on{color:var(--sg-ink);border-bottom-color:var(--sg-accent)}
  .sg-close{background:none;border:0;font:inherit;font-size:1.5rem;line-height:1;cursor:pointer;color:var(--sg-muted);padding:0 0 0 .4rem}
  .sg-close:hover{color:var(--sg-ink)}
  .sg-scroll{overflow-x:auto;-webkit-overflow-scrolling:touch;margin:0 -.25rem}
  .sg-table{width:100%;border-collapse:collapse;font-size:.9rem;min-width:300px}
  .sg-table th,.sg-table td{text-align:left!important;padding:.7rem .8rem;border-bottom:1px solid var(--sg-line);white-space:nowrap;line-height:1.3}
  .sg-table thead th{background:var(--sg-head);font-weight:600;font-size:.66rem;letter-spacing:.14em;text-transform:uppercase;color:var(--sg-muted);border-bottom:0}
  .sg-table thead th:first-child{border-radius:3px 0 0 3px}
  .sg-table thead th:last-child{border-radius:0 3px 3px 0}
  .sg-table tbody td:first-child{font-weight:600}
  .sg-table tbody tr:last-child td{border-bottom:0}
  .sg-table .sg-u{font-size:.85em;color:var(--sg-muted);margin-left:.2em;letter-spacing:.06em}
  .sg-wrap[data-unit="in"] .sg-cm,.sg-wrap[data-unit="cm"] .sg-in{display:none}
  .sg-note{margin:1rem 0 0;font-size:.8rem;color:var(--sg-muted);line-height:1.55}
  .sg-how{margin:.9rem 0 0;border-top:1px solid var(--sg-line)}
  .sg-how summary{list-style:none;cursor:pointer;padding:.8rem 0 .2rem;font-size:.68rem;letter-spacing:.14em;text-transform:uppercase;color:var(--sg-ink);display:flex;align-items:center;gap:.5rem}
  .sg-how summary::-webkit-details-marker{display:none}
  .sg-how summary::after{content:"+";margin-left:auto;font-size:1rem;color:var(--sg-muted)}
  .sg-how[open] summary::after{content:"–"}
  .sg-how ul{margin:.3rem 0 0;padding:0;list-style:none;font-size:.8rem;line-height:1.55;color:var(--sg-ink)}
  .sg-how li{padding:.45rem 0;border-top:1px solid var(--sg-line)}
  .sg-how li:first-child{border-top:0}
  .sg-how strong{font-weight:600;color:var(--sg-muted);font-size:.66rem;letter-spacing:.12em;text-transform:uppercase;display:block;margin-bottom:.1rem}
  @media (max-width:749px){
    .sg-modal{align-items:flex-end;padding:0}
    .sg-panel{max-width:none;max-height:86vh;border-radius:14px 14px 0 0;padding:1.2rem 1.1rem 1.6rem;box-shadow:0 -10px 40px rgba(20,28,36,.2);animation:sgUp .22s ease-out}
    .sg-table{font-size:.85rem}
    .sg-table th,.sg-table td{padding:.6rem .6rem}
  }
  @keyframes sgUp{from{transform:translateY(24px);opacity:.6}to{transform:none;opacity:1}}
</style>
<div class="sg-wrap" id="{{ sg_id }}" data-unit="{{ sg_unit }}">
  <button type="button" class="sg-open" aria-haspopup="dialog" aria-controls="{{ sg_id }}-modal">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><rect x="2.5" y="8" width="19" height="8" rx="1.5"/><path d="M6.5 8v3M10 8v4.5M13.5 8v3M17 8v4.5"/></svg>
    <span>Size guide</span>
  </button>
  <div class="sg-modal" id="{{ sg_id }}-modal" role="dialog" aria-modal="true" aria-label="Size guide" hidden>
    <div class="sg-overlay" data-sg-close></div>
    <div class="sg-panel">
      <div class="sg-head">
        <h2 class="sg-title">Size guide</h2>
        <div class="sg-units" role="group" aria-label="Units">
          <button type="button" data-sg-unit="in"{% if sg_unit == 'in' %} class="on"{% endif %}>in</button>
          <button type="button" data-sg-unit="cm"{% if sg_unit == 'cm' %} class="on"{% endif %}>cm</button>
        </div>
        <button type="button" class="sg-close" aria-label="Close" data-sg-close>&times;</button>
      </div>
      <div class="sg-scroll">
        <table class="sg-table">
          <thead>
            <tr>
              {%- for c in sg.columns -%}
                <th scope="col">{{ c.label | escape }}{% if c.kind == 'length' %}<span class="sg-u sg-in">in</span><span class="sg-u sg-cm">cm</span>{% elsif c.kind == 'mass' %}<span class="sg-u sg-in">lb</span><span class="sg-u sg-cm">kg</span>{% endif %}</th>
              {%- endfor -%}
            </tr>
          </thead>
          <tbody>
            {%- for row in sg.rows -%}
              <tr>
                {%- for c in sg.columns -%}
                  {%- assign v = row[c.key] -%}
                  <td>
                    {%- if v == blank -%}
                      &ndash;
                    {%- elsif c.kind == 'length' or c.kind == 'mass' -%}
                      {%- if c.kind == 'length' -%}{%- assign f = 0.3937 -%}{%- else -%}{%- assign f = 2.2046 -%}{%- endif -%}
                      {%- if v.first != blank -%}
                        {%- assign a = v.first | times: 1.0 -%}{%- assign b = v.last | times: 1.0 -%}
                        <span class="sg-in">{{ a | times: f | round: 1 | append: '' | replace: '.0', '' }}&ndash;{{ b | times: f | round: 1 | append: '' | replace: '.0', '' }}</span><span class="sg-cm">{{ a | round: 1 | append: '' | replace: '.0', '' }}&ndash;{{ b | round: 1 | append: '' | replace: '.0', '' }}</span>
                      {%- else -%}
                        {%- assign a = v | times: 1.0 -%}
                        <span class="sg-in">{{ a | times: f | round: 1 | append: '' | replace: '.0', '' }}</span><span class="sg-cm">{{ a | round: 1 | append: '' | replace: '.0', '' }}</span>
                      {%- endif -%}
                    {%- else -%}
                      {{ v | escape }}
                    {%- endif -%}
                  </td>
                {%- endfor -%}
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
      {%- if sg.note != blank -%}<p class="sg-note">{{ sg.note | escape }}</p>{%- endif -%}
      {%- if sg.how_to_measure.size > 0 -%}
        <details class="sg-how">
          <summary>How to measure</summary>
          <ul>
            {%- for h in sg.how_to_measure -%}
              {%- assign lbl = h.key -%}
              {%- for c in sg.columns -%}{%- if c.key == h.key -%}{%- assign lbl = c.label -%}{%- endif -%}{%- endfor -%}
              <li><strong>{{ lbl | escape }}</strong>{{ h.text | escape }}</li>
            {%- endfor -%}
          </ul>
        </details>
      {%- endif -%}
    </div>
  </div>
</div>
<script>
  (function () {
    var wrap = document.getElementById('{{ sg_id }}');
    if (!wrap || wrap.dataset.sgReady) return;
    wrap.dataset.sgReady = '1';
    var modal = wrap.querySelector('.sg-modal');
    var openBtn = wrap.querySelector('.sg-open');
    var KEY = 'sg_unit';
    function setUnit(u, save) {
      wrap.setAttribute('data-unit', u);
      wrap.querySelectorAll('[data-sg-unit]').forEach(function (b) { b.classList.toggle('on', b.getAttribute('data-sg-unit') === u); });
      if (save) { try { localStorage.setItem(KEY, u); } catch (e) {} }
    }
    try { var saved = localStorage.getItem(KEY); if (saved === 'in' || saved === 'cm') setUnit(saved, false); } catch (e) {}
    function open() { modal.hidden = false; document.documentElement.style.overflow = 'hidden'; var c = modal.querySelector('.sg-close'); if (c) c.focus(); }
    function close() { modal.hidden = true; document.documentElement.style.overflow = ''; openBtn.focus(); }
    openBtn.addEventListener('click', open);
    modal.querySelectorAll('[data-sg-close]').forEach(function (el) { el.addEventListener('click', close); });
    modal.querySelectorAll('[data-sg-unit]').forEach(function (b) { b.addEventListener('click', function () { setUnit(b.getAttribute('data-sg-unit'), true); }); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !modal.hidden) close(); });
  })();
</script>
{%- endif -%}
