<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>

    {% comment %} Uitgezet 22-11: oud Everman shipping-protection-script (verkeerde store). PTL gebruikt nu ptl-cart-drawer. {% endcomment %}{% comment %}
    <script>
(function () {
  var VARIANT_ID = 59088725508477; // Everman Clothing shipping protection
  var OPTOUT = 'sp_user_off';
  var SELECTOR = 'button.kaching-cart-toggle[aria-label="Shipping protection"]';
  var PROT_ITEM = { id: VARIANT_ID, quantity: 1, properties: { _kaching_cart: '{"isUpsellToggle":true}' } };
  var cartHasProtection = false, ensuring = false, timer = null;
  var origFetch = window.fetch;

  function optedOut() {
    try { return sessionStorage.getItem(OPTOUT) === '1'; } catch (e) { return false; }
  }
  function isProt(i) { return i.variant_id === VARIANT_ID; }
  function isAddUrl(url) { return /\/cart\/add(\.js)?(\?|$)/.test(url || ''); }
  function isChangeUrl(url) { return /\/cart\/(add|change|update|clear)(\.js)?(\?|$)/.test(url || ''); }
  function post(url, body) {
    return origFetch(url, {
      method: 'POST', credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body)
    });
  }
  function refresh() {
    try { if (window.kachingCartApi && window.kachingCartApi.refreshCart) window.kachingCartApi.refreshCart(); } catch (e) {}
  }

  function ensure() {
    if (ensuring) return;
    ensuring = true;
    origFetch('/cart.js', { credentials: 'same-origin' })
      .then(function (r) { return r.json(); })
      .then(function (cart) {
        var line = cart.items.filter(isProt)[0];
        var products = cart.items.filter(function (i) { return !isProt(i); }).length;
        cartHasProtection = !!line;
        if (line && products === 0) {
          return post('/cart/change.js', { id: line.key, quantity: 0 })
            .then(function () { cartHasProtection = false; refresh(); });
        }
        if (!line && products > 0 && !optedOut()) {
          return post('/cart/add.js', { items: [PROT_ITEM] })
            .then(function (r) { if (r.ok) { cartHasProtection = true; refresh(); } });
        }
      })
      .catch(function () {})
      .then(function () { ensuring = false; });
  }
  function schedule() { clearTimeout(timer); timer = setTimeout(ensure, 350); }

  function transform(body) {
    if (cartHasProtection || optedOut() || !body) return null;
    try {
      var items = null, extra = {};
      if (typeof body === 'string') {
        var t = body.trim();
        if (t.charAt(0) === '{') {
          var o = JSON.parse(t);
          if (Array.isArray(o.items)) {
            items = o.items; delete o.items; extra = o;
          } else if (o.id) {
            items = [{ id: o.id, quantity: o.quantity || 1, properties: o.properties, selling_plan: o.selling_plan }];
            ['sections', 'sections_url', 'attributes', 'note'].forEach(function (k) { if (o[k] != null) extra[k] = o[k]; });
          }
        } else {
          body = new URLSearchParams(t);
        }
      }
      if (!items && (body instanceof FormData || body instanceof URLSearchParams)) {
        var it = { quantity: 1 }, props = {};
        body.forEach(function (v, k) {
          if (typeof v !== 'string') return;
          var m = k.match(/^properties\[(.+)\]$/);
          if (k === 'id') it.id = v;
          else if (k === 'quantity') it.quantity = parseInt(v, 10) || 1;
          else if (k === 'selling_plan') { if (v) it.selling_plan = v; }
          else if (m) props[m[1]] = v;
          else if (k === 'sections' || k === 'sections_url') extra[k] = v;
        });
        if (it.id) {
          if (Object.keys(props).length) it.properties = props;
          items = [it];
        }
      }
      if (!items || !items.length) return null;
      if (items.some(function (i) { return String(i.id) === String(VARIANT_ID); })) return null;
      extra.items = items.concat([PROT_ITEM]);
      return JSON.stringify(extra);
    } catch (e) { return null; }
  }

  window.fetch = function (input, init) {
    var url = typeof input === 'string' ? input : (input && input.url) || '';
    var changed = false;
    if (isAddUrl(url) && init && init.body) {
      var nb = transform(init.body);
      if (nb) {
        var h = new Headers(init.headers || {});
        h.set('Content-Type', 'application/json');
        init = Object.assign({}, init, { body: nb, headers: h });
        changed = true;
      }
    }
    var p = origFetch.call(this, input, init);
    if (!isChangeUrl(url)) return p;
    return p.then(function (res) {
      schedule();
      if (changed && res.ok) {
        return res.clone().json().then(function (d) {
          cartHasProtection = true;
          var merged = Object.assign({}, d.items && d.items[0], d);
          return new Response(JSON.stringify(merged), { status: res.status, statusText: res.statusText, headers: res.headers });
        }).catch(function () { return res; });
      }
      return res;
    });
  };

  var xhrOpen = XMLHttpRequest.prototype.open;
  XMLHttpRequest.prototype.open = function (method, url) {
    if (isChangeUrl(String(url))) this.addEventListener('loadend', schedule);
    return xhrOpen.apply(this, arguments);
  };

  document.addEventListener('click', function (e) {
    var b = e.target && e.target.closest && e.target.closest(SELECTOR);
    if (!b) return;
    try {
      if (cartHasProtection) sessionStorage.setItem(OPTOUT, '1');
      else sessionStorage.removeItem(OPTOUT);
    } catch (err) {}
  }, true);

  document.addEventListener('DOMContentLoaded', ensure);
  window.addEventListener('pageshow', ensure);
})();
</script>
    {% endcomment %}
    {% render 'css-variables' %}

    {% unless settings.type_primary_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
      {{ settings.type_primary_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}

    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    <meta name="format-detection" content="telephone=no, email=no, address=no">

    {% if settings.favicon %}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {% else %}
      <link rel="icon" type="image/png" href="{{ 'ptl-favicon.png' | asset_url }}">
    {% endif %}

    {% render 'meta-tags' %}
    {%- if settings.cart_type != 'page' -%}
      {{ 'cart-drawer.css' | asset_url | stylesheet_tag }}
    {%- endif -%}
    {{ content_for_header }}

    {{ 'sections.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'sections.js' | asset_url }}" defer></script>
    {{ 'ux.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'ux.js' | asset_url }}" defer></script>
    {{ 'ux-addons.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'ux-addons.js' | asset_url }}" defer></script>
    {{ 'emc-skin.css' | asset_url | stylesheet_tag }}
    {{ 'emc-sale.css' | asset_url | stylesheet_tag }}
    {{ 'emc-fixes.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'emc-polish.js' | asset_url }}" defer></script>
  </head>

  <body class="template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}--{{ template.suffix }}{% endif %}">
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>
    {% sections 'header-group' %}
    {%- if settings.cart_type != 'page' -%}
      {% render 'cart-drawer' %}
    {%- endif -%}

    {% section "ptl-cart-drawer" %}
    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- if settings.cart_type != 'page' -%}
      <script src="{{ 'cart-drawer.js' | asset_url }}" defer></script>
    {%- endif -%}
  </body>
</html>
