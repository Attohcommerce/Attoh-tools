{%- comment -%}
  Pierre the Label cart drawer (22-11-2026), built from the Code of Clothes cart.
  Top bar, discount steps with a message above them and a ship-by line, products with variant
  selects and savings, compact "Complete your look" suggestions with quick add, shipping protection
  toggle, discounts, total and checkout. Every text is editable in the theme editor.
  assets/ptl-cart-drawer.js re-renders it with the Section Rendering API; the suggestions come from
  sections/ptl-cart-recs.liquid.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign sp = s.protection_product
  if sp == blank
    assign sp = all_products['shipping-protection']
  endif
  assign sp_variant = nil
  if s.protection_enabled and sp != blank
    if sp.available
      assign sp_variant = sp.selected_or_first_available_variant
    endif
  endif
  assign sp_line = nil
  assign count = 0
  assign savings = 0
  assign first_pid = ''
  assign ids = ''
  for item in cart.items
    assign is_sp = false
    if item.product.type == 'Shipping Protection'
      assign is_sp = true
    endif
    if sp != blank and item.product_id == sp.id
      assign is_sp = true
    endif
    if is_sp
      assign sp_line = item
    else
      assign count = count | plus: item.quantity
      if first_pid == blank
        assign first_pid = item.product_id | append: ''
      endif
      assign ids = ids | append: item.product_id | append: ','
      assign ref = item.original_price
      if item.variant.compare_at_price > ref
        assign ref = item.variant.compare_at_price
      endif
      assign ref_line = ref | times: item.quantity
      assign save = ref_line | minus: item.final_line_price
      if save > 0
        assign savings = savings | plus: save
      endif
    endif
  endfor
  for app in cart.cart_level_discount_applications
    assign savings = savings | plus: app.total_allocated_amount
  endfor
  assign pay_types = 'apple_pay,google_pay,master,shopify_pay,visa' | split: ','

  assign tier_n = 0
  assign last_i = 0
  assign next_q = 0
  assign next_l = ''
  assign cur_l = ''
  for i in (1..4)
    assign qk = 'tier_' | append: i | append: '_qty'
    assign lk = 'tier_' | append: i | append: '_label'
    assign q = s[qk]
    if q > 0 and s[lk] != blank
      assign tier_n = tier_n | plus: 1
      assign last_i = i
      if count >= q
        assign cur_l = s[lk]
      elsif next_q == 0
        assign next_q = q
        assign next_l = s[lk]
      endif
    endif
  endfor
  assign msg = ''
  if tier_n > 0
    assign c_html = cur_l | escape | prepend: '<strong>' | append: '</strong>'
    if next_q > 0
      assign need = next_q | minus: count
      if need == 1
        assign word = s.progress_one
      else
        assign word = s.progress_many
      endif
      assign n_html = need | append: ' ' | append: word | escape | prepend: '<strong>' | append: '</strong>'
      if cur_l == blank
        assign tpl = s.progress_start
      else
        assign tpl = s.progress_next
      endif
      assign d_html = next_l | escape | prepend: '<strong>' | append: '</strong>'
    else
      assign n_html = ''
      assign tpl = s.progress_done
      assign d_html = c_html
    endif
    assign msg = tpl | escape | replace: '[needed]', n_html | replace: '[discount]', d_html | replace: '[current]', c_html
  endif
  assign empty_1 = s.empty_1_link | default: '/collections/sale'
  assign empty_2 = s.empty_2_link | default: '/collections/bestsellers'
-%}
{%- if s.enabled -%}
{{ 'ptl-cart-drawer.css' | asset_url | stylesheet_tag }}
<ptl-cart-drawer
  class="ptl-cart"
  data-cart-drawer
  data-sold-out="{{ s.sold_out | escape }}"
  data-recs-url="{{ routes.product_recommendations_url }}"
  data-recs-fallback="{% if s.recs_collection != blank %}{{ s.recs_collection.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}"
  data-recs-select="{{ s.recs_select | escape }}"
  data-recs-add="{{ s.recs_add | escape }}"
  data-ship-days="{{ s.eta_days }}"
  data-ship-skip="{{ s.eta_skip_weekend }}"
  data-ship-locale="en-GB"
  aria-hidden="true"
  style="--cc-accent: {{ s.accent }}; --cc-red: {{ s.save_color }}; --cc-bar: {{ s.bar_color }};"
>
  <div class="ptl-cart__overlay" data-close></div>
  <div class="ptl-cart__panel" role="dialog" aria-modal="true" aria-label="{{ s.heading | escape }}" tabindex="-1">
    <div class="ptl-cart__inner" data-ptl-cart-inner>
      <div hidden data-state data-count="{{ count }}" data-sp-key="{% if sp_line %}{{ sp_line.key }}{% endif %}" data-sp-qty="{% if sp_line %}{{ sp_line.quantity }}{% else %}0{% endif %}" data-sp-variant="{% if sp_variant %}{{ sp_variant.id }}{% endif %}" data-sp-auto="{{ s.protection_auto }}" data-first="{{ first_pid }}" data-ids="{{ ids }}"></div>

      <div class="ptl-cart__head">
        <p class="ptl-cart__heading">{{ s.heading | escape }}<span>({{ count }})</span></p>
        <button type="button" class="ptl-cart__close" data-close aria-label="Close cart">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </div>

      {%- if count == 0 -%}
        <div class="ptl-cart__empty">
          <span class="ptl-cart__empty-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 8h14l-1 12H6z"/><path d="M9 8V6a3 3 0 016 0v2"/></svg></span>
          <p class="ptl-cart__empty-title">{{ s.empty_title | escape }}</p>
          {%- if s.empty_text != blank -%}<p class="ptl-cart__empty-text">{{ s.empty_text | escape }}</p>{%- endif -%}
          <div class="ptl-cart__empty-ctas">
            {%- if s.empty_1_label != blank -%}<a class="ptl-cart__btn" href="{{ empty_1 }}" data-close-link>{{ s.empty_1_label | escape }}</a>{%- endif -%}
            {%- if s.empty_2_label != blank -%}<a class="ptl-cart__btn ptl-cart__btn--ghost" href="{{ empty_2 }}" data-close-link>{{ s.empty_2_label | escape }}</a>{%- endif -%}
          </div>
        </div>
      {%- else -%}
        {%- if s.message != blank -%}
          <p class="ptl-cart__bar-msg">{{ s.message | escape }}</p>
        {%- endif -%}
        {%- if tier_n > 0 or s.eta_text != blank -%}
          <div class="ptl-cart__steps">
            {%- if msg != blank -%}
              <p class="ptl-cart__steps-msg"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.6 13.4l-7.2 7.2a2 2 0 01-2.8 0L3 13V3h10l7.6 7.6a2 2 0 010 2.8z"/><circle cx="7.5" cy="7.5" r="1.5"/></svg><span>{{ msg }}</span></p>
            {%- endif -%}
            {%- if tier_n > 0 -%}
              <div class="ptl-cart__bar">
                <span class="ptl-cart__track" aria-hidden="true"><span class="ptl-cart__fill" data-fill></span></span>
                <ol class="ptl-cart__tiers" role="list">
                  {%- assign k = 0 -%}
                  {%- for i in (1..4) -%}
                    {%- assign qk = 'tier_' | append: i | append: '_qty' -%}
                    {%- assign lk = 'tier_' | append: i | append: '_label' -%}
                    {%- assign q = s[qk] -%}
                    {%- if q > 0 and s[lk] != blank -%}
                      {%- assign k = k | plus: 1 -%}
                      {%- assign pos = k | times: 100.0 | divided_by: tier_n -%}
                      {%- assign qtxt = q | append: '' -%}
                      {%- if i == last_i -%}{%- assign qtxt = qtxt | append: '+' -%}{%- endif -%}
                      <li class="ptl-cart__tier{% if count >= q %} is-reached{% elsif q == next_q %} is-next{% endif %}" data-tier data-qty="{{ q }}" style="left: {{ pos }}%;">
                        <span class="ptl-cart__dot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span>
                        <span class="ptl-cart__tier-label">{{ s[lk] | escape }}</span>
                        {%- if s.tier_sub != blank -%}<span class="ptl-cart__tier-sub">{{ s.tier_sub | replace: '[qty]', qtxt | escape }}</span>{%- endif -%}
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                </ol>
              </div>
            {%- endif -%}
            {%- if s.eta_text != blank -%}
              {%- assign eta = s.eta_text | escape | replace: '[date]', '<strong data-shipby-date></strong>' -%}
              <p class="ptl-cart__eta"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h11v10H3zM14 9h4l3 3v4h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17.5" cy="17.5" r="1.8"/></svg><span>{{ eta }}</span></p>
            {%- endif -%}
          </div>
        {%- endif -%}

        <div class="ptl-cart__scroll">
          <p class="ptl-cart__flash" data-flash hidden></p>
          <ul class="ptl-cart__items" role="list">
            {%- for item in cart.items -%}
              {%- liquid
                assign is_sp = false
                if item.product.type == 'Shipping Protection'
                  assign is_sp = true
                endif
                if sp != blank and item.product_id == sp.id
                  assign is_sp = true
                endif
                if is_sp
                  continue
                endif
                assign ref = item.original_price
                if item.variant.compare_at_price > ref
                  assign ref = item.variant.compare_at_price
                endif
                assign ref_line = ref | times: item.quantity
                assign save = ref_line | minus: item.final_line_price
              -%}
              <li class="ptl-cart__item" data-line="{{ item.key }}" data-variant="{{ item.variant_id }}" data-qty="{{ item.quantity }}" data-props="{% if item.properties.size > 0 %}{{ item.properties | json | escape }}{% else %}{}{% endif %}">
                <a class="ptl-cart__media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
                  {%- if item.image -%}
                    {{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', class: 'ptl-cart__img', alt: '', sizes: '84px', widths: '120, 180, 240' }}
                  {%- endif -%}
                </a>
                <div class="ptl-cart__info">
                  <div class="ptl-cart__top">
                    <a class="ptl-cart__name" href="{{ item.url }}">{{ item.product.title | escape }}</a>
                    <span class="ptl-cart__prices">
                      <span class="ptl-cart__price">{{ item.final_line_price | money }}</span>
                      {%- if ref_line > item.final_line_price -%}<s class="ptl-cart__compare">{{ ref_line | money }}</s>{%- endif -%}
                    </span>
                  </div>
                  {%- unless item.product.has_only_default_variant -%}
                    <div class="ptl-cart__opts">
                      {%- for option in item.product.options_with_values -%}
                        {%- assign oi = forloop.index0 -%}
                        <span class="ptl-cart__select">
                          <select data-opt="{{ oi }}" aria-label="{{ option.name | escape }}">
                            {%- for value in option.values -%}
                              {%- assign vn = value | append: '' -%}
                              <option value="{{ vn | escape }}"{% if item.variant.options[oi] == vn %} selected{% endif %}>{{ vn | escape }}</option>
                            {%- endfor -%}
                          </select>
                          <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2.5 4.5L6 8l3.5-3.5"/></svg>
                        </span>
                      {%- endfor -%}
                    </div>
                  {%- endunless -%}
                  <div class="ptl-cart__bottom">
                    <div class="ptl-cart__qty">
                      <button type="button" data-qty-step="-1" aria-label="Decrease quantity"{% if item.quantity <= 1 %} disabled{% endif %}><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M2.5 6h7"/></svg></button>
                      <span>{{ item.quantity }}</span>
                      <button type="button" data-qty-step="1" aria-label="Increase quantity"><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M2.5 6h7M6 2.5v7"/></svg></button>
                    </div>
                    {%- if save > 0 -%}<span class="ptl-cart__pill ptl-cart__pill--save">{{ s.item_save | escape }} {{ save | money_without_trailing_zeros }}</span>{%- endif -%}
                    <button type="button" class="ptl-cart__remove" data-remove aria-label="Remove {{ item.product.title | escape }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 12a2 2 0 002 2h6a2 2 0 002-2l1-12M9 7V4h6v3"/></svg></button>
                  </div>
                  <script type="application/json" data-variants>[{%- for v in item.product.variants -%}{"id":{{ v.id }},"o":{{ v.options | json }},"a":{{ v.available | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]</script>
                </div>
              </li>
            {%- endfor -%}
          </ul>
          {%- if s.recs_enabled -%}
            <div class="ptl-cart__recs" data-recs hidden>
              <div class="ptl-cart__recs-head"><p class="ptl-cart__recs-title">{{ s.recs_title | escape }}</p><div class="ptl-cart__recs-nav" data-recs-nav hidden><button type="button" class="ptl-cart__recs-arrow" data-recs-prev aria-label="Previous suggestions" disabled><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.5 2.5L4 6l3.5 3.5"/></svg></button><button type="button" class="ptl-cart__recs-arrow" data-recs-next aria-label="More suggestions"><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 2.5L8 6l-3.5 3.5"/></svg></button></div></div>
              <ul class="ptl-cart__recs-row" role="list" data-recs-row></ul>
            </div>
          {%- endif -%}
        </div>

        <div class="ptl-cart__foot">
          {%- if sp_variant -%}
            <div class="ptl-cart__protect">
              <span class="ptl-cart__protect-icon">
                {%- if sp.featured_image -%}
                  {{ sp.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '', sizes: '34px', widths: '72, 120' }}
                {%- else -%}
                  <svg viewBox="0 0 48 48" fill="none" aria-hidden="true"><path d="M6 16l16-8 16 8v17l-16 8-16-8z" fill="#E8EDE9" stroke="#1D3A2B" stroke-width="1.6" stroke-linejoin="round"/><path d="M6 16l16 8 16-8M22 24v17" stroke="#1D3A2B" stroke-width="1.6" stroke-linejoin="round"/><path d="M37 24l7 3v6.2c0 4.6-3 8.3-7 9.8-4-1.5-7-5.2-7-9.8V27z" fill="#141816"/><path d="M33.8 33.4l2.3 2.3 4.2-4.6" stroke="#FFFFFF" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {%- endif -%}
              </span>
              <span><span class="ptl-cart__protect-title">{{ s.protection_title | escape }}</span>{%- if s.protection_text != blank -%}<span class="ptl-cart__protect-text">{{ s.protection_text | escape }}</span>{%- endif -%}</span>
              <span class="ptl-cart__protect-price">{{ sp_variant.price | money }}</span>
              <label class="ptl-cart__switch">
                <input type="checkbox" data-protect{% if sp_line %} checked{% endif %} aria-label="{{ s.protection_title | escape }}">
                <span aria-hidden="true"></span>
              </label>
            </div>
          {%- endif -%}
          <div class="ptl-cart__sum">
            {%- if s.shipping_label != blank -%}
              <div class="ptl-cart__row"><span>{{ s.shipping_label | escape }}</span><span>{{ s.shipping_value | escape }}</span></div>
            {%- endif -%}
            {%- if savings > 0 -%}
              <div class="ptl-cart__row ptl-cart__row--save"><span>{{ s.save_label | escape }}</span><span>-{{ savings | money }}</span></div>
            {%- endif -%}
            <div class="ptl-cart__row ptl-cart__row--total"><span>{{ s.total_label | escape }}</span><span>{{ cart.total_price | money }}</span></div>
          </div>
          <form action="{{ routes.cart_url }}" method="post" class="ptl-cart__checkout-form" data-checkout-form>
            <button type="submit" name="checkout" class="ptl-cart__checkout" data-checkout>
              <span class="ptl-cart__spinner" aria-hidden="true"></span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 018 0v3"/></svg>
              <span>{{ s.checkout_label | escape }}</span>
            </button>
          </form>
          {%- if s.show_payment_icons -%}
            <ul class="ptl-cart__pay" role="list">
              {%- for type in shop.enabled_payment_types -%}
                {%- if pay_types contains type -%}<li>{{ type | payment_type_svg_tag }}</li>{%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</ptl-cart-drawer>
<script src="{{ 'ptl-cart-drawer.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "Cart drawer",
  "class": "ptl-cart-section",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Use the cart drawer", "default": true, "info": "Off = customers go to the cart page" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your cart" },
    { "type": "text", "id": "message", "label": "Top bar", "default": "Great choice! Free Royal Mail tracked delivery included", "info": "Empty = hidden" },
    { "type": "color", "id": "bar_color", "label": "Top bar colour", "default": "#1D3A2B" },
    { "type": "header", "content": "Discount steps" },
    { "type": "paragraph", "content": "Keep these the same as your automatic discounts. Items 0 = step hidden." },
    { "type": "range", "id": "tier_1_qty", "label": "Step 1: items", "min": 0, "max": 10, "step": 1, "default": 2 },
    { "type": "text", "id": "tier_1_label", "label": "Step 1: label", "default": "10% off" },
    { "type": "range", "id": "tier_2_qty", "label": "Step 2: items", "min": 0, "max": 10, "step": 1, "default": 3 },
    { "type": "text", "id": "tier_2_label", "label": "Step 2: label", "default": "15% off" },
    { "type": "range", "id": "tier_3_qty", "label": "Step 3: items", "min": 0, "max": 10, "step": 1, "default": 4 },
    { "type": "text", "id": "tier_3_label", "label": "Step 3: label", "default": "20% off" },
    { "type": "range", "id": "tier_4_qty", "label": "Step 4: items", "min": 0, "max": 10, "step": 1, "default": 0 },
    { "type": "text", "id": "tier_4_label", "label": "Step 4: label", "default": "30% off" },
    { "type": "text", "id": "progress_start", "label": "Text above the steps (start)", "default": "Add [needed] to unlock [discount]", "info": "[needed] = for example 1 more piece, [discount] = the next step" },
    { "type": "text", "id": "progress_next", "label": "Text above the steps (between)", "default": "[current] unlocked! Add [needed] for [discount]", "info": "[current] = the step the customer already has" },
    { "type": "text", "id": "progress_done", "label": "Text above the steps (last step)", "default": "Nice! You unlocked our best deal: [discount]" },
    { "type": "text", "id": "progress_one", "label": "Words after 1", "default": "more piece" },
    { "type": "text", "id": "progress_many", "label": "Words after 2 or more", "default": "more pieces" },
    { "type": "text", "id": "tier_sub", "label": "Small text under each step", "info": "For example Buy [qty]. [qty] = number of pieces. Empty = hidden" },
    { "type": "header", "content": "Ship-by date" },
    { "type": "text", "id": "eta_text", "label": "Text", "default": "Order now, ships by [date]", "info": "[date] = same rule as on the product page. Empty = hidden" },
    { "type": "range", "id": "eta_days", "label": "Days after today", "min": 0, "max": 10, "step": 1, "default": 1 },
    { "type": "checkbox", "id": "eta_skip_weekend", "label": "Move weekend dates to Monday", "default": true },
    { "type": "header", "content": "Products" },
    { "type": "text", "id": "item_save", "label": "Savings label", "default": "You save" },
    { "type": "text", "id": "sold_out", "label": "Sold out message", "default": "This option is sold out" },
    { "type": "color", "id": "save_color", "label": "Savings colour", "default": "#B3202A" },
    { "type": "header", "content": "Complete your look" },
    { "type": "checkbox", "id": "recs_enabled", "label": "Show product suggestions", "default": true },
    { "type": "text", "id": "recs_title", "label": "Heading", "default": "Complete your look" },
    { "type": "collection", "id": "recs_collection", "label": "Backup collection", "info": "Used while Shopify has no suggestions yet. Empty = all products" },
    { "type": "text", "id": "recs_select", "label": "Size placeholder", "default": "Size" },
    { "type": "text", "id": "recs_add", "label": "Add button (screen readers)", "default": "Add" },
    { "type": "header", "content": "Shipping protection" },
    { "type": "checkbox", "id": "protection_enabled", "label": "Show shipping protection", "default": true },
    { "type": "product", "id": "protection_product", "label": "Product", "info": "Empty = the product with handle shipping-protection" },
    { "type": "checkbox", "id": "protection_auto", "label": "Add automatically", "default": true, "info": "Customers can switch it off in the cart" },
    { "type": "text", "id": "protection_title", "label": "Title", "default": "Shipping protection" },
    { "type": "text", "id": "protection_text", "label": "Text", "default": "Protect your order from being lost or damaged." },
    { "type": "header", "content": "Totals and checkout" },
    { "type": "text", "id": "shipping_label", "label": "Shipping label", "info": "For example Shipping. Empty = row hidden" },
    { "type": "text", "id": "shipping_value", "label": "Shipping value", "default": "Free" },
    { "type": "text", "id": "save_label", "label": "Discounts label", "default": "Discounts" },
    { "type": "text", "id": "total_label", "label": "Total label", "default": "Total" },
    { "type": "text", "id": "checkout_label", "label": "Checkout button", "default": "Secure checkout" },
    { "type": "color", "id": "accent", "label": "Button, toggle and step colour", "default": "#141816" },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true },
    { "type": "header", "content": "Empty cart" },
    { "type": "text", "id": "empty_title", "label": "Title", "default": "Your cart is empty" },
    { "type": "text", "id": "empty_text", "label": "Text", "default": "Free Royal Mail tracked delivery and 30-day returns on every order." },
