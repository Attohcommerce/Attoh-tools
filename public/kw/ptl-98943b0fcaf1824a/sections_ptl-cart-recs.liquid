{%- comment -%}
  Product suggestions for the cart drawer (19-11-2026). Only fetched by assets/ptl-cart-drawer.js:
  /recommendations/products?product_id=..&section_id=ptl-cart-recs, or a collection URL with
  ?section_id=ptl-cart-recs as backup. Skips products that are already in the cart.
{%- endcomment -%}
{%- liquid
  assign in_cart = ','
  for item in cart.items
    assign in_cart = in_cart | append: item.product_id | append: ','
  endfor
  assign list = nil
  if recommendations.performed and recommendations.products_count > 0
    assign list = recommendations.products
  elsif collection
    assign list = collection.products
  endif
  assign shown = 0
-%}
<ul data-ptl-recs>
  {%- if list -%}
    {%- for product in list -%}
      {%- liquid
        assign pid = ',' | append: product.id | append: ','
        if in_cart contains pid or product.available == false or product.type == 'Shipping Protection'
          continue
        endif
        if shown >= 6
          break
        endif
        assign shown = shown | plus: 1
        assign fv = product.selected_or_first_available_variant
      -%}
      <li class="ptl-cart__rec">
        <a class="ptl-cart__rec-media" href="{{ product.url }}">
          {%- if product.featured_media -%}
            {{ product.featured_media | image_url: width: 320 | image_tag: loading: 'lazy', alt: product.title, sizes: '136px', widths: '200, 320' }}
          {%- endif -%}
          {%- if product.compare_at_price > product.price -%}
            {%- assign pct = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
            <span class="ptl-cart__rec-badge">SAVE {{ pct }}%</span>
          {%- endif -%}
        </a>
        <a class="ptl-cart__rec-name" href="{{ product.url }}">{{ product.title | split: '|' | last | strip | escape }}</a>
        <p class="ptl-cart__rec-price">{{ product.price | money }}{%- if product.compare_at_price > product.price -%}<s>{{ product.compare_at_price | money }}</s>{%- endif -%}</p>
        <div class="ptl-cart__rec-form" data-rec>
          {%- if product.has_only_default_variant -%}
            <input type="hidden" value="{{ fv.id }}" data-rec-variant>
          {%- else -%}
            <span class="ptl-cart__select">
              <select data-rec-variant aria-label="{{ product.options | join: ', ' | escape }}">
                <option value="" data-rec-ph>Select size</option>
                {%- for variant in product.variants -%}
                  {%- if variant.available -%}<option value="{{ variant.id }}">{{ variant.title | escape }}</option>{%- endif -%}
                {%- endfor -%}
              </select>
              <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2.5 4.5L6 8l3.5-3.5"/></svg>
            </span>
          {%- endif -%}
          <button type="button" class="ptl-cart__rec-add" data-rec-add><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M2.5 6h7M6 2.5v7"/></svg><span data-rec-label>Add</span></button>
        </div>
      </li>
    {%- endfor -%}
  {%- endif -%}
</ul>

{% schema %}
{
  "name": "Cart suggestions"
}
{% endschema %}
