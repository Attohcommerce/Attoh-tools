{%- liquid
  assign menu = section.settings.menu
  assign left_count = section.settings.left_links
  assign logo_alt = section.settings.logo.alt | default: shop.name
-%}
{%- style -%}
  #shopify-section-{{ section.id }} {
    --header-bg: {{ section.settings.color_background }};
    --header-fg: {{ section.settings.color_text }};
    --logo-w: {{ section.settings.logo_width }}px;
    --logo-w-m: {{ section.settings.logo_width_mobile }}px;
  }
{%- endstyle -%}
{{ 'emc-nav.css' | asset_url | stylesheet_tag }}

<ux-header class="ux-header{% if section.settings.sticky %} ux-header--sticky{% endif %}">
  <header class="ux-header__bar">
    <div class="ux-page ux-header__row">
      <div class="ux-header__zone ux-header__zone--left">
        <button type="button" class="ux-header__icon ux-header__burger" aria-controls="UxNavDrawer" aria-expanded="false" data-drawer-open>
          {% render 'ux-icon', icon: 'menu' %}<span class="visually-hidden">{{ 'sections.header.menu' | t | default: 'Menu' }}</span>
        </button>
        <nav class="ux-nav" aria-label="{{ 'sections.header.menu' | t | default: 'Menu' }}">
          <ul class="ux-nav__list" role="list">
            {%- for link in menu.links limit: left_count -%}
              {% render 'ux-nav-item', link: link, section: section, index: forloop.index %}
            {%- endfor -%}
          </ul>
        </nav>
      </div>

      <div class="ux-header__logo">
        {%- if request.page_type == 'index' -%}<h1 class="ux-header__logo-h">{%- endif -%}
        <a href="{{ routes.root_url }}" class="ux-header__logo-link">
          {%- if section.settings.logo != blank -%}
            {{ section.settings.logo | image_url: width: 800 | image_tag: class: 'ux-header__logo-img', widths: '200, 300, 400, 600, 800', sizes: '(min-width: 769px) var(--logo-w), var(--logo-w-m)', alt: logo_alt, loading: 'eager' }}
          {%- else -%}
            <img class="ux-header__logo-img" src="{{ 'logo-wordmark.svg' | asset_url }}" alt="{{ shop.name | escape }}" width="1734" height="200">
          {%- endif -%}
        </a>
        {%- if request.page_type == 'index' -%}</h1>{%- endif -%}
      </div>

      <div class="ux-header__zone ux-header__zone--right">
        <nav class="ux-nav" aria-label="{{ 'sections.header.menu' | t | default: 'Menu' }}">
          <ul class="ux-nav__list" role="list">
            {%- for link in menu.links offset: left_count -%}
              {%- assign idx = forloop.index | plus: left_count -%}
              {% render 'ux-nav-item', link: link, section: section, index: idx %}
            {%- endfor -%}
          </ul>
        </nav>
        <div class="ux-header__icons">
          {%- if section.settings.show_search -%}
            <button type="button" class="ux-header__icon" data-search-open aria-controls="UxSearch" aria-expanded="false">
              {% render 'ux-icon', icon: 'search' %}<span class="visually-hidden">{{ 'general.search.search' | t | default: 'Search' }}</span>
            </button>
          {%- endif -%}
          <a href="{{ routes.cart_url }}" class="ux-header__icon ux-header__cart" id="cart-icon-bubble">
            {% render 'ux-icon', icon: 'bag' %}<span class="visually-hidden">{{ 'templates.cart.cart' | t | default: 'Cart' }}</span>
            {%- assign ptl_count = cart.item_count -%}{%- for ptl_item in cart.items -%}{%- if ptl_item.product.type == "Shipping Protection" -%}{%- assign ptl_count = ptl_count | minus: ptl_item.quantity -%}{%- endif -%}{%- endfor -%}<span class="ux-header__count{% if ptl_count == 0 %} is-empty{% endif %}" data-cart-count>{{ ptl_count }}</span>
          </a>
        </div>
      </div>
    </div>
  </header>

  {%- if section.settings.show_search -%}
    <div class="ux-search" id="UxSearch" hidden>
      <div class="ux-page">
        <form action="{{ routes.search_url }}" method="get" role="search" class="ux-search__form">
          <input type="hidden" name="options[prefix]" value="last">
          {% render 'ux-icon', icon: 'search', class: 'ux-search__icon' %}
          <input class="ux-search__input" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ section.settings.search_placeholder | escape }}" aria-label="{{ 'general.search.search' | t | default: 'Search' }}">
          <button type="button" class="ux-search__close" data-search-close>{% render 'ux-icon', icon: 'close' %}<span class="visually-hidden">{{ 'accessibility.close' | t | default: 'Close' }}</span></button>
        </form>
      </div>
    </div>
  {%- endif -%}
</ux-header>

<ux-drawer class="ux-drawer" id="UxNavDrawer" aria-hidden="true">
  <div class="ux-drawer__overlay" data-drawer-close></div>
  <div class="ux-drawer__panel{% if section.settings.mnav_cards %} emc-mnav-panel{% endif %}" role="dialog" aria-modal="true" aria-label="{{ 'sections.header.menu' | t | default: 'Menu' }}" tabindex="-1">
    {%- if section.settings.mnav_cards -%}
      {%- comment -%} 12-11 (EMC nav, same as LGB): mobile menu with photo cards, sale row, USP's. Off = the old list below. {%- endcomment -%}
      <div class="ux-drawer__head emc-mnav-head">
        <a href="{{ routes.root_url }}" class="emc-mnav-head__logo">
          {%- if section.settings.logo != blank -%}
            {{ section.settings.logo | image_url: width: 400 | image_tag: loading: 'lazy', alt: logo_alt, widths: '200, 400', sizes: '130px' }}
          {%- else -%}
            <img src="{{ 'logo-wordmark.svg' | asset_url }}" alt="{{ shop.name | escape }}" width="1734" height="200" loading="lazy">
          {%- endif -%}
        </a>
        <button type="button" class="ux-drawer__close" data-drawer-close>{% render 'ux-icon', icon: 'close' %}<span class="visually-hidden">{{ 'accessibility.close' | t | default: 'Close' }}</span></button>
      </div>
      <div class="ux-drawer__scroll emc-mnav-scroll">
        {%- if section.settings.mnav_promo_heading != blank -%}
          {%- if section.settings.mnav_promo_link != blank -%}<a class="emc-mnav-promo" href="{{ section.settings.mnav_promo_link }}">{%- else -%}<div class="emc-mnav-promo">{%- endif -%}
            {%- if section.settings.mnav_promo_eyebrow != blank -%}<span class="emc-mnav-promo__eyebrow">{{ section.settings.mnav_promo_eyebrow | escape }}</span>{%- endif -%}
            <span class="emc-mnav-promo__heading">{{ section.settings.mnav_promo_heading | escape }}</span>
          {%- if section.settings.mnav_promo_link != blank -%}<span class="emc-mnav-promo__arrow" aria-hidden="true">&rarr;</span></a>{%- else -%}</div>{%- endif -%}
        {%- endif -%}
        <div class="emc-mnav-cards">
          {%- for link in menu.links -%}
            {%- liquid
              assign card = false
              for child in link.links
                if child.type == 'collection_link' or child.links != blank
                  assign card = true
                  break
                endif
              endfor
              if card == false
                continue
              endif
              assign grouped = false
              for child in link.links
                if child.links != blank
                  assign grouped = true
                  break
                endif
              endfor
              assign fimg = nil
              assign fblock = nil
              for block in section.blocks
                if block.type == 'mega_feature'
                  assign bt = block.settings.menu_title | strip | downcase
                  assign lt = link.title | strip | downcase
                  if bt == lt
                    assign fblock = block
                    if block.settings.image != blank
                      assign fimg = block.settings.image
                    endif
                    break
                  endif
                endif
              endfor
            -%}
            <details class="emc-mnav-card">
              <summary class="emc-mnav-card__head">
                {%- liquid
                  comment
                    Card photo: "Mobile menu card image" of the mega menu block, else the AI photo from this
                    collection or its sub-collections, else the mega menu image.
                  endcomment
                  assign card_img = ''
                  if fblock.settings.mobile_image != blank
                    assign card_pos = 'object-position: 50% ' | append: fblock.settings.mobile_focus | append: '%;'
                    capture card_img
                      echo fblock.settings.mobile_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: link.title, widths: '450, 900', sizes: '100vw', style: card_pos
                    endcapture
                    assign card_img = card_img | strip
                  endif
                  if card_img == blank
                    capture card_img
                      render 'emc-nav-img', col: link.object, width: 900, alt: link.title, sizes: '100vw', ai_only: true
                    endcapture
                    assign card_img = card_img | strip
                  endif
                  if card_img == blank
                    for child in link.links
                      capture card_img
                        render 'emc-nav-img', col: child.object, width: 900, alt: link.title, sizes: '100vw', ai_only: true
                      endcapture
                      assign card_img = card_img | strip
                      if card_img != blank
                        break
                      endif
                      for gc in child.links
                        capture card_img
                          render 'emc-nav-img', col: gc.object, width: 900, alt: link.title, sizes: '100vw', ai_only: true
                        endcapture
                        assign card_img = card_img | strip
                        if card_img != blank
                          break
                        endif
                      endfor
                      if card_img != blank
                        break
                      endif
                    endfor
                  endif
                  if card_img == blank
                    capture card_img
                      render 'emc-nav-img', col: link.object, width: 900, alt: link.title, fallback: fimg, sizes: '100vw'
                    endcapture
                    assign card_img = card_img | strip
                  endif
                -%}
                <span class="emc-mnav-card__media">{{ card_img }}</span>
                <span class="emc-mnav-card__text">
                  <span class="emc-mnav-card__title">{{ link.title }}</span>
                  {%- if section.settings.show_counts and link.type == 'collection_link' and link.object.products_count > 0 -%}
                    <span class="emc-mnav-card__count">{{ link.object.products_count }} {{ section.settings.styles_label | default: 'styles' | escape }}</span>
                  {%- endif -%}
                </span>
                <span class="emc-mnav-card__chev" aria-hidden="true">{% render 'ux-icon', icon: 'chevron-down' %}</span>
              </summary>
              <div class="emc-mnav-card__body">
                <a class="emc-mnav-shopall" href="{{ link.url }}">{{ section.settings.shop_all_label | default: 'Shop all' | escape }} {{ link.title }} <span aria-hidden="true">&rarr;</span></a>
                {%- if grouped and link.links.size > 3 -%}
                  {%- comment -%} EMC: many groups (Shirts, Shorts, Pants, Shoes …) → one photo tile per group {%- endcomment -%}
                  <ul class="emc-mnav-chips" role="list">
                    {%- for child in link.links -%}<li>{% render 'emc-nav-chip', l: child, section: section, kind: 'mnav' %}</li>{%- endfor -%}
                  </ul>
                {%- elsif grouped -%}
                  {%- for child in link.links -%}
                    <p class="emc-mnav-group">{{ child.title }}</p>
                    <ul class="emc-mnav-chips" role="list">
                      {%- if child.links != blank -%}
                        {%- for gc in child.links -%}<li>{% render 'emc-nav-chip', l: gc, section: section, kind: 'mnav' %}</li>{%- endfor -%}
                      {%- else -%}
                        <li>{% render 'emc-nav-chip', l: child, section: section, kind: 'mnav' %}</li>
                      {%- endif -%}
                    </ul>
                  {%- endfor -%}
                {%- else -%}
                  <ul class="emc-mnav-chips" role="list">
                    {%- for child in link.links -%}<li>{% render 'emc-nav-chip', l: child, section: section, kind: 'mnav' %}</li>{%- endfor -%}
                  </ul>
                {%- endif -%}
              </div>
            </details>
          {%- endfor -%}
        </div>
        <ul class="emc-mnav-list" role="list">
          {%- assign badge_item = section.settings.mnav_badge_item | strip | downcase -%}
          {%- for link in menu.links -%}
            {%- liquid
              assign card = false
              for child in link.links
                if child.type == 'collection_link' or child.links != blank
                  assign card = true
                  break
                endif
              endfor
              if card
                continue
              endif
              assign lt = link.title | strip | downcase
            -%}
            <li>
              {%- if link.links != blank -%}
                <details class="emc-mnav-acc">
                  <summary class="emc-mnav-row">
                    <span>{{ link.title }}</span>
                    <span class="emc-mnav-row__chev" aria-hidden="true">{% render 'ux-icon', icon: 'chevron-down' %}</span>
                  </summary>
                  <ul class="emc-mnav-acc__list" role="list">
                    {%- for child in link.links -%}<li><a href="{{ child.url }}">{{ child.title }}</a></li>{%- endfor -%}
                  </ul>
                </details>
              {%- elsif badge_item != blank and lt == badge_item and section.settings.mnav_badge_text != blank -%}
                <a class="emc-mnav-row emc-mnav-row--sale" href="{{ link.url }}"><span>{{ link.title }}</span><span class="emc-mnav-badge">{{ section.settings.mnav_badge_text | escape }}</span></a>
              {%- else -%}
                <a class="emc-mnav-row" href="{{ link.url }}"><span>{{ link.title }}</span><span class="emc-mnav-row__arrow" aria-hidden="true">&rarr;</span></a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
        {%- if section.settings.mnav_usp_1 != blank or section.settings.mnav_usp_2 != blank or section.settings.mnav_usp_3 != blank -%}
          <ul class="emc-mnav-usps" role="list">
            {%- if section.settings.mnav_usp_1 != blank -%}<li><span aria-hidden="true">&#10003;</span> {{ section.settings.mnav_usp_1 | escape }}</li>{%- endif -%}
            {%- if section.settings.mnav_usp_2 != blank -%}<li><span aria-hidden="true">&#10003;</span> {{ section.settings.mnav_usp_2 | escape }}</li>{%- endif -%}
            {%- if section.settings.mnav_usp_3 != blank -%}<li><span aria-hidden="true">&#10003;</span> {{ section.settings.mnav_usp_3 | escape }}</li>{%- endif -%}
          </ul>
        {%- endif -%}
        {%- liquid
          assign has_social = false
          if settings.social_instagram_link != blank or settings.social_pinterest_link != blank or settings.social_facebook_link != blank or settings.social_tiktok_link != blank
            assign has_social = true
          endif
        -%}
        {%- if has_social -%}
          <ul class="ux-drawer__social emc-mnav-social" role="list">
            {%- if settings.social_instagram_link != blank -%}<li><a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener">{% render 'ux-icon', icon: 'instagram' %}<span class="visually-hidden">Instagram</span></a></li>{%- endif -%}
            {%- if settings.social_pinterest_link != blank -%}<li><a href="{{ settings.social_pinterest_link }}" target="_blank" rel="noopener">{% render 'ux-icon', icon: 'pinterest' %}<span class="visually-hidden">Pinterest</span></a></li>{%- endif -%}
            {%- if settings.social_facebook_link != blank -%}<li><a href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener">{% render 'ux-icon', icon: 'facebook' %}<span class="visually-hidden">Facebook</span></a></li>{%- endif -%}
            {%- if settings.social_tiktok_link != blank -%}<li><a href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener">{% render 'ux-icon', icon: 'tiktok' %}<span class="visually-hidden">TikTok</span></a></li>{%- endif -%}
          </ul>
        {%- endif -%}
      </div>
    {%- else -%}
    <div class="ux-drawer__head">
      <button type="button" class="ux-drawer__close" data-drawer-close>{% render 'ux-icon', icon: 'close' %}<span class="visually-hidden">{{ 'accessibility.close' | t | default: 'Close' }}</span></button>
    </div>
    <div class="ux-drawer__scroll">
      <ul class="ux-mnav" role="list">
        {%- for link in menu.links -%}
          <li class="ux-mnav__item">
            {%- if link.links != blank -%}
              <details class="ux-mnav__details">
                <summary class="ux-mnav__row">
                  <a class="ux-mnav__link" href="{{ link.url }}">{{ link.title }}</a>
                  <span class="ux-mnav__toggle" aria-hidden="true">{% render 'ux-icon', icon: 'chevron-down' %}</span>
                </summary>
                <ul class="ux-mnav__sub" role="list">
                  <li><a class="ux-mnav__sublink ux-mnav__subrow ux-mnav__all" href="{{ link.url }}">{{ section.settings.shop_all_label | default: 'Shop all' | escape }} {{ link.title }}</a></li>
                  {%- for child in link.links -%}
                    <li>
                      {%- if child.links != blank -%}
                        <details class="ux-mnav__details ux-mnav__details--sub" open>
                          <summary class="ux-mnav__subrow">
                            <a class="ux-mnav__sublink" href="{{ child.url }}">{{ child.title }}</a>
                            <span class="ux-mnav__subtoggle" aria-hidden="true">{% render 'ux-icon', icon: 'chevron-down' %}</span>
                          </summary>
                          <ul class="ux-mnav__sub ux-mnav__sub--deep" role="list">
                            {%- for grandchild in child.links -%}
                              <li><a class="ux-mnav__sublink" href="{{ grandchild.url }}">{{ grandchild.title }}</a></li>
                            {%- endfor -%}
                          </ul>
                        </details>
                      {%- else -%}
                        <a class="ux-mnav__sublink ux-mnav__subrow" href="{{ child.url }}">{{ child.title }}</a>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>
              </details>
            {%- else -%}
              <a class="ux-mnav__link ux-mnav__row" href="{{ link.url }}">{{ link.title }}</a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
      {%- liquid
        assign has_social = false
        if settings.social_instagram_link != blank or settings.social_pinterest_link != blank or settings.social_facebook_link != blank or settings.social_tiktok_link != blank
          assign has_social = true
        endif
      -%}
      {%- if has_social -%}
        <ul class="ux-drawer__social" role="list">
          {%- if settings.social_instagram_link != blank -%}<li><a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener">{% render 'ux-icon', icon: 'instagram' %}<span class="visually-hidden">Instagram</span></a></li>{%- endif -%}
          {%- if settings.social_pinterest_link != blank -%}<li><a href="{{ settings.social_pinterest_link }}" target="_blank" rel="noopener">{% render 'ux-icon', icon: 'pinterest' %}<span class="visually-hidden">Pinterest</span></a></li>{%- endif -%}
          {%- if settings.social_facebook_link != blank -%}<li><a href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener">{% render 'ux-icon', icon: 'facebook' %}<span class="visually-hidden">Facebook</span></a></li>{%- endif -%}
          {%- if settings.social_tiktok_link != blank -%}<li><a href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener">{% render 'ux-icon', icon: 'tiktok' %}<span class="visually-hidden">TikTok</span></a></li>{%- endif -%}
        </ul>
      {%- endif -%}
    </div>
    {%- endif -%}
  </div>
</ux-drawer>

{% schema %}
{
  "name": "Header",
  "class": "ux-section-header",
  "max_blocks": 24,
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "range", "id": "logo_width", "label": "Logo width (desktop)", "min": 80, "max": 420, "step": 10, "unit": "px", "default": 220 },
    { "type": "range", "id": "logo_width_mobile", "label": "Logo width (mobile)", "min": 60, "max": 260, "step": 5, "unit": "px", "default": 150 },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "range", "id": "left_links", "label": "Menu items left of the logo", "min": 1, "max": 6, "step": 1, "default": 4, "info": "The rest of the menu sits right of the logo." },
    { "type": "checkbox", "id": "show_counts", "label": "Show product counts in the mega menu", "default": true },
    { "type": "text", "id": "shop_all_label", "label": "Shop all label", "default": "Shop all" },
    { "type": "checkbox", "id": "mega_photos", "label": "Mega menu with product photos", "default": true, "info": "Collection links show as photo tiles. The photo comes from the first product with a model photo, otherwise the collection image." },
    { "type": "text", "id": "mega_group_label", "label": "Heading above the photo tiles", "default": "Shop by category" },
    { "type": "header", "content": "Mobile menu" },
    { "type": "checkbox", "id": "mnav_cards", "label": "Mobile menu with photo cards", "default": true },
    { "type": "text", "id": "mnav_promo_eyebrow", "label": "Sale bar small heading", "default": "Black Friday sale" },
    { "type": "text", "id": "mnav_promo_heading", "label": "Sale bar heading", "default": "Up to 45% off", "info": "Empty = no sale bar" },
    { "type": "url", "id": "mnav_promo_link", "label": "Sale bar link", "info": "Empty = not clickable (no arrow)" },
    { "type": "text", "id": "mnav_badge_item", "label": "Menu item with sale badge", "default": "Sale", "info": "Exact title of the menu item" },
    { "type": "text", "id": "mnav_badge_text", "label": "Sale badge text", "default": "Up to 45% off" },
    { "type": "text", "id": "mnav_usp_1", "label": "USP 1", "default": "Free tracked UK delivery" },
    { "type": "text", "id": "mnav_usp_2", "label": "USP 2", "default": "30-day easy returns" },
    { "type": "text", "id": "mnav_usp_3", "label": "USP 3", "default": "Reply within 1 hour on business days" },
    { "type": "text", "id": "styles_label", "label": "Count word in the mega menu", "default": "styles" },
    { "type": "checkbox", "id": "sticky", "label": "Sticky header", "default": true },
    { "type": "checkbox", "id": "show_search", "label": "Show search", "default": true },
    { "type": "text", "id": "search_placeholder", "label": "Search placeholder", "default": "Search for coats, knitwear, boots…" },
    { "type": "color", "id": "color_background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "color_text", "label": "Text", "default": "#141816" }
  ],
  "blocks": [
    {
      "type": "mega_feature",
      "name": "Mega menu image",
      "settings": [
        { "type": "text", "id": "menu_title", "label": "Menu item", "info": "Exact title of the top-level menu item, for example Women's" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "New season" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "The collection" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
        { "type": "url", "id": "link", "label": "Button link" },
        { "type": "image_picker", "id": "mobile_image", "label": "Mobile menu card image", "info": "Photo on the big card in the mobile menu. Empty = automatic photo" },
        { "type": "range", "id": "mobile_focus", "label": "Mobile card image focus (top to bottom)", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50 }
      ]
    },
    {
      "type": "nav_photo",
      "name": "Menu photo",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Or menu item title", "info": "For menu items that are not a collection, for example New In" },
        { "type": "image_picker", "id": "image", "label": "Photo", "info": "Used for this collection's photo tile in the mega menu and the mobile menu" }
      ]
    }
  ]
}
{% endschema %}
