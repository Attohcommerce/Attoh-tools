{%- comment -%}
  Text page built from blocks (About us, FAQ). All text editable in the theme editor.
{%- endcomment -%}
<div class="ux-page ux-pagecontent{% if section.settings.hide_title %} ux-pagecontent--flush{% endif %}">
  {%- unless section.settings.hide_title -%}
  <header class="ux-pagecontent__head">
    <h1 class="ux-pagecontent__title">{{ section.settings.title | default: page.title | escape }}</h1>
  </header>
  {%- endunless -%}
  <div class="ux-rte ux-pagecontent__body">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'heading' -%}
          {%- unless forloop.first -%}<hr>{%- endunless -%}
          <h2 {{ block.shopify_attributes }}>{{ block.settings.heading | escape }}</h2>
        {%- when 'text' -%}
          <div class="ux-pagecontent__block" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
        {%- when 'question' -%}
          <div class="ux-pagecontent__qa" {{ block.shopify_attributes }}>
            <p class="ux-pagecontent__q"><strong>{{ block.settings.question | escape }}</strong></p>
            <div class="ux-pagecontent__a">{{ block.settings.answer }}</div>
          </div>
        {%- when 'divider' -%}
          <hr {{ block.shopify_attributes }}>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Text page",
  "class": "ux-section-page",
  "settings": [
    { "type": "text", "id": "title", "label": "Page heading", "info": "Leave empty to use the page title" },
    { "type": "checkbox", "id": "hide_title", "label": "Hide the page heading", "default": false }
  ],
  "blocks": [
    { "type": "heading", "name": "Heading", "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Heading" } ] },
    { "type": "text", "name": "Text", "settings": [ { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Text</p>" } ] },
    { "type": "question", "name": "Question", "settings": [
      { "type": "text", "id": "question", "label": "Question", "default": "Question" },
      { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Answer</p>" }
    ] },
    { "type": "divider", "name": "Divider", "settings": [] }
  ],
  "presets": [{ "name": "Text page" }]
}
{% endschema %}
